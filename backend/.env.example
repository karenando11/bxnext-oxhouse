# Copy this file to .env (which is git-ignored) and adjust. Never commit real secrets.

# Required
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://oxhouse:oxhouse@localhost:5432/oxhouse

# Optional
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Finviz Elite export token. Read at call time, never logged. Put it in your environment or here.
FINVIZ_AUTH_TOKEN=
# Where raw downloads are stored (default: backend/var/raw, git-ignored)
# RAW_STORAGE_DIR=
