# Copy this file to .env (which is git-ignored) and adjust. Never commit real secrets.

# Required
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# The address the running app uses. For Neon, use the POOLED address (host contains "-pooler") and
# keep ?sslmode=require. Local development uses the Docker database below.
DATABASE_URL=postgres://oxhouse:oxhouse@localhost:5432/oxhouse
# Optional: the DIRECT (non-pooled) address. `manage.py` commands other than runserver use it, so
# migrations and the nightly batch jobs avoid the pooler. Leave unset for a local database.
# DATABASE_DIRECT_URL=

# Optional
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Finviz Elite export token. Read at call time, never logged. Put it in your environment or here.
FINVIZ_AUTH_TOKEN=
# SEC contact for the User-Agent header (a name and an email address). Read at call time.
SEC_USER_AGENT=
# Raw downloads: kept on local disk in development (RAW_STORAGE_DIR, default backend/var/raw,
# git-ignored) and never kept in production, where only the parsed rows and each download's hash
# are stored. RAW_STORAGE_BACKEND is "local" or "none"; the default follows DJANGO_DEBUG, and
# "local" is refused when DJANGO_DEBUG is off.
# RAW_STORAGE_BACKEND=
# RAW_STORAGE_DIR=

# Alert email (Step 17). Leave ALERT_EMAIL_TO empty to send alerts to the error log only.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
