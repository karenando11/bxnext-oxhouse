# Copy to /srv/oxhouse/.env on the server and fill in. Never commit the real file.
SITE_DOMAIN=
# Space-separated CIDR ranges that may reach the site, e.g. "203.0.113.0/24 198.51.100.7/32"
ALLOWED_NETWORKS=

POSTGRES_USER=oxhouse
POSTGRES_PASSWORD=
POSTGRES_DB=oxhouse

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
SEC_USER_AGENT=
FINVIZ_AUTH_TOKEN=

ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

SENTRY_DSN=

# Backups: any S3-compatible bucket
BACKUP_S3_URI=s3://example-bucket/oxhouse
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
BACKUP_KEEP_DAYS=30
